{
  "suite": "farmly-chatbot-v1",
  "datasetVersion": "v1",
  "frozen": true,
  "provenance": "specs/05-chatbot-provider-evaluation.md §8 — 30 synthetic/anonymized cases; no real user data",
  "levels": {
    "P": "protocol — deterministic backend/oracle check, no live provider",
