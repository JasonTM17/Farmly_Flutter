# Node and generated API output
**/node_modules/
**/dist/
**/coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Dart and Flutter generated output
**/.dart_tool/
**/.pub/
**/build/
**/coverage/
**/.flutter-plugins
**/.flutter-plugins-dependencies
/.flutter
/.flutter_tool_state
**/.packages
**/ephemeral/

# Local environment and signing material
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.mobileprovision

# Local operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Farmly-local Android virtual device and emulator state
/.farmly-local/

# Local agent/tool session state (not project source)
**/.mimosa/
/.playwright-mcp/
/.video_agent/
/.zcode/workflow-drafts/
/.zcode/workflow-runs/

# Leftover platform scaffold sandbox and shell redirect artifacts
/.platform-scaffold-temp/
apps/mobile/.platform-scaffold-temp/
/nul
apps/mobile/nul
apps/mobile/test/golden/failures/

# Eclipse/JDT generated project settings
**/.settings/

# ── Local-only agent/tooling registries & internal planning ─────────────
# AgentKit and other agent runtimes live on the developer machine only.
# They must never reach the remote: they are not product source, may
# embed machine-specific paths, and bloat history by thousands of files.
/.agentkit/
/.agents/
/.codex/
/.devin/
/.claude/
/.cursor/
/.gemini/
/.opencode/
/.omp/
/.grok/
/.mimosa/
/.playwright-mcp/
/.video_agent/
/.zcode/

# Internal planning, specs, evidence packets and execution ledgers
# (working documents, not a public deliverable).
/plans/

# Local scratch/patch artifacts
/_*.py
# Scratch patch/case scripts (one-off migration patchers, machine paths)
**/_p[0-9]*
/.zcodeignore
